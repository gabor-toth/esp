# CONFIG_ESPTOOLPY_FLASHSIZE_2MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_hajo.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_hajo.csv"
CONFIG_EXAMPLE_MDNS_HOST_NAME="n2k-gateway"
CONFIG_MDNS_INSTANCE_NAME="N2K Gateway"

CONFIG_PM_ENABLE=y
CONFIG_COMPILER_STACK_CHECK_MODE_ALL=y
CONFIG_COMPILER_STACK_CHECK=y

#? CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
#? CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

CONFIG_TIMER_TASK_STACK_DEPTH=4096
CONFIG_TASK_WDT_PANIC=y
CONFIG_SYSTEM_EVENT_TASK_STACK_SIZE=3072
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6172

CONFIG_CONSOLE_UART_DEFAULT is not set
CONFIG_CONSOLE_UART_CUSTOM=y
CONFIG_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_CONSOLE_UART_TX_GPIO=40
CONFIG_CONSOLE_UART_RX_GPIO=39
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
# CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_1 is not set
CONFIG_ESP_CONSOLE_UART_TX_GPIO=40
CONFIG_ESP_CONSOLE_UART_RX_GPIO=39

CONFIG_WPA_DEBUG_PRINT=y
CONFIG_IPC_TASK_STACK_SIZE=2048
CONFIG_MAIN_TASK_STACK_SIZE=6172
CONFIG_SYSTEM_EVENT_TASK_STACK_SIZE=3072
CONFIG_REDUCE_PHY_TX_POWER=y
CONFIG_ESP32_REDUCE_PHY_TX_POWER=y
CONFIG_ESP_PHY_REDUCE_TX_POWER=y
# CONFIG_ESP_PHY_ENABLE_USB is not set
# CONFIG_STACK_CHECK_NONE is not set
CONFIG_STACK_CHECK_ALL=y
CONFIG_STACK_CHECK=y

CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_DHCP_MAX_NTP_SERVERS=1
CONFIG_LWIP_LOCAL_HOSTNAME="n2k-gateway"
CONFIG_LWIP_CHECK_THREAD_SAFETY=y
CONFIG_LWIP_MAX_SOCKETS=12

CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS is not set
#? CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
#? CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
#? CONFIG_FREERTOS_OPTIMIZED_SCHEDULER=y

CONFIG_FREERTOS_OPTIMIZED_SCHEDULER=y
CONFIG_ESP_TASK_WDT_PANIC=y

# CONFIG_EXAMPLE_CONNECT_IPV6 is not set
# CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS is not set
CONFIG_HTTPD_WS_SUPPORT=y

all LVGL, TOUCH
